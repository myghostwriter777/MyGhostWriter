# Client-safe configuration
REACT_APP_GOOGLE_CLIENT_ID=
REACT_APP_STRIPE_PUBLISHABLE_KEY=

# Server-only AI configuration
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# Optional: comma-separated voice IDs to publish as GhostwriterMe's curated set.
# Leave empty to show up to 100 voices available to the ElevenLabs account.
ELEVENLABS_VOICE_IDS=

# Optional model override. Defaults to Multilingual v2, or Eleven v3 for Thai.
ELEVENLABS_MODEL_ID=

# Stripe server configuration
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_REGULAR=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_MASTER_MONTHLY=
STRIPE_PRICE_MASTER_REGULAR=
STRIPE_PRICE_MASTER_YEARLY=

# Legacy Student prices: keep while older subscriptions remain active
STRIPE_PRICE_STUDENT_MONTHLY=
STRIPE_PRICE_STUDENT_REGULAR=
STRIPE_PRICE_STUDENT_YEARLY=

# Supabase server configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
